{
  "name": "qa-app",
  "version": "1.0.0",
  "description": "QA App with wall detection from PDF drawings",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:backend": "cd backend && uvicorn main:app --host 127.0.0.1 --port 8001 --reload",
    "dev": "node dev-start.js",
    "build": "tsc",
    "test": "cd backend && python -m pytest tests/ -v"
  },
  "dependencies": {
    "pdfjs-dist": "^4.0.379",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "@types/node": "^20.10.6",
    "@types/express": "^4.17.21",
    "@types/uuid": "^9.0.7"
  }
}
